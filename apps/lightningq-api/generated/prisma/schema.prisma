// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  UserId             Int            @id @default(autoincrement())
  Prefix             Title
  imageUrl           String
  firstName          String
  lastName           String
  gender             String
  email              String         @unique
  mobile             String         @unique
  passwordHash       String
  isActive           Boolean        @default(true)
  hashedRefreshToken String
  dateOfBirth        DateTime
  roleId             Int
  role               Role           @relation(fields: [roleId], references: [RoleId])
  SpecializationId   Int
  Specialization     Specialization @relation(fields: [SpecializationId], references: [SpecializationId])
  Experience         String
  Employee_ID        String
  SignatureOfUser    String
  organizationId     Int
  organization       Organization   @relation(fields: [organizationId], references: [OrganizationId])

  // Settings and Sessions
  settings      Setting?       @relation("UserSettings")
  auditLogs     AuditLog[]
  loginSessions LoginSession[]

  // Many-to-Many via UserHospitalAccess
  AdminAccess UserHospitalAccess[] @relation("UserAdminAccess") // Link to hospitals with role

  // Admin CRUD metadata
  createdAt DateTime @default(now())

  createdById Int?
  createdBy   User? @relation("UserCreatedUsers", fields: [createdById], references: [UserId])

  updatedById Int?
  updatedBy   User? @relation("UserUpdatedUsers", fields: [updatedById], references: [UserId])

  deletedById Int?
  deletedBy   User? @relation("UserDeletedUsers", fields: [deletedById], references: [UserId])

  deletedAt DateTime?

  // Reverse relations for audit trail
  createdUsers User[] @relation("UserCreatedUsers")
  updatedUsers User[] @relation("UserUpdatedUsers")
  deletedUsers User[] @relation("UserDeletedUsers")

  // Relation for hospital info
  UserBranchesArray Hospital[] @relation("UserHospitals")
  HospitalCreatedBy Hospital[] @relation("UserCreatedHospitals")
  HospitalUpdatedBy Hospital[] @relation("UserUpdatedHospitals")
  HospitalDeletedBy Hospital[] @relation("UserDeletedHospitals")

  UserHospitalAccess UserHospitalAccess[] @relation("CreatedUserHospitalAccess")

  DoctorTimeSlot DoctorTimeSlot[]

  DoctorCosting DoctorCosting[]

  DoctorCostingCreatedBy DoctorCosting[] @relation("UserCreatedDoctorCosting")

  DoctorAppointments Appointment[] @relation("Doctor")

  AssignedProviderAppointment Appointment[] @relation("AssignedProvider")

  ConsultationSpecialist Appointment[] @relation("Specialist")

  AppointmentCreatedBy Appointment[] @relation("CreatedBy")

  Appointment Appointment[] @relation("RescheduledBy")
}

// Organization (Top-most head entity created by you or BA)
model Organization {
  OrganizationId   Int                 @id @default(autoincrement())
  OrganizationName String // Official hospital group/organization name
  Organizationcode String              @unique // Short unique code e.g. "JKH01"
  logoUrl          String // Optional logo for branding
  email            String              @unique
  contactNumber    String
  Orgnizationtype  OrganizationType?
  website          String
  addressLine1     String
  addressLine2     String
  city             String
  state            String
  country          String
  postalCode       String
  registrationNo   String // Govt/Medical Reg Number if applicable
  establishedOn    DateTime // Foundation/Start date
  industryType     String // Optional, e.g. "Healthcare", "Diagnostics"
  status           Hospital_Org_status @default(ACTIVE) // Enum for status
  description      String? // Optional about/description field

  // Relations
  hospitals Hospital[]
  users     User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  Patient Patient[]
}

// Hospital entity (can be super/child/sub-child)
model Hospital {
  HospitalId         Int                @id @default(autoincrement())
  HospitalName       String
  HospitalCode       String             @unique
  ParentHospitalCode String
  Organizationcode   String
  SpecializationType SpecializationType
  address            String
  city               String
  state              String
  country            String
  postalCode         String
  contactNumber      String
  email              String
  website            String
  logoUrl            String

  latitude         Float
  longitude        Float
  status           Hospital_Org_status @default(ACTIVE)
  level            HospitalLevel?
  // Hierarchical relation
  parentHospitalId Int?
  parentHospital   Hospital?           @relation("HospitalHierarchy", fields: [parentHospitalId], references: [HospitalId])
  childHospital    Hospital[]          @relation("HospitalHierarchy")

  // Organization it belongs to

  Organization   Organization         @relation(fields: [organizationId], references: [OrganizationId])
  organizationId Int
  // User-to-Hospital mapping
  users          UserHospitalAccess[]
  mappedUsers    User[]               @relation("UserHospitals")

  isActive    Boolean @default(true)
  createdById Int?
  CreatedBy   User?   @relation("UserCreatedHospitals", fields: [createdById], references: [UserId])
  updatedById Int?
  UpdatedBy   User?   @relation("UserUpdatedHospitals", fields: [updatedById], references: [UserId])

  deletedById Int?
  DeletedBy   User? @relation("UserDeletedHospitals", fields: [deletedById], references: [UserId])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now())
  deletedAt DateTime?

  DoctorTimeSlot DoctorTimeSlot[]

  DoctorCosting DoctorCosting[]

  Appointment Appointment[]

  Patient Patient[]
}

// User ↔ Hospital mapping model
model UserHospitalAccess {
  UserHospitalAccessId Int @id @default(autoincrement())

  UserId Int
  User   User @relation("UserAdminAccess", fields: [UserId], references: [UserId])

  hospitalId Int
  hospital   Hospital @relation(fields: [hospitalId], references: [HospitalId])

  roleId Int
  role   Role @relation(fields: [roleId], references: [RoleId])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  createdById Int?
  createdBy   User? @relation("CreatedUserHospitalAccess", fields: [createdById], references: [UserId])

  @@unique([UserId, hospitalId]) // Prevent duplicate mappings
}

model DoctorTimeSlotHistory {
  DoctorTimeSlotHistoryId          Int      @id @default(autoincrement())
  DoctorTimeSlotId                 Int?
  userId                           Int
  HospitalId                       Int
  DayOfWeek                        String
  Morning_From                     String?
  Morning_To                       String?
  Evening_From                     String?
  Evening_To                       String?
  consult_Time_InMin               Int
  Accept_Appointment_Selected_Date Boolean
  is_DND                           Boolean
  is_SlotCancelled                 Boolean
  isPermanentCancelled             Boolean
  DNDremarks                       String?
  Slot_cancellation_remarks        String?
  isDeleted                        Boolean
  isAvailable                      Boolean
  isBooked                         Boolean
  isConfirmed                      Boolean
  isRejected                       Boolean
  createdAt                        DateTime
  updatedAt                        DateTime
  changedAt                        DateTime @default(now()) // ← when change happened
  changedBy                        Int // ← user who made the change
  isSlotChanged                    Boolean? // ✅ Add this here
  isActive                         Boolean  @default(true)
  createdBy                        Int?
}

model Setting {
  SettingId Int    @id @default(autoincrement())
  UserId    Int    @unique
  theme     String @default("light")
  language  String @default("en")
  user      User   @relation("UserSettings", fields: [UserId], references: [UserId])
}

model DoctorTimeSlot {
  DoctorTimeSlotId Int @id @default(autoincrement())

  // 🔗 Link to User (Doctor)
  userId Int
  user   User @relation(fields: [userId], references: [UserId], onDelete: Cascade)

  // 🔗 Link to Hospital
  HospitalId Int
  Hospital   Hospital @relation(fields: [HospitalId], references: [HospitalId], onDelete: Cascade)

  DayOfWeek String // e.g., 'MON', 'TUE', etc.

  Morning_From String? // Format: 'HH:mm'
  Morning_To   String?

  Evening_From String?
  Evening_To   String?

  consult_Time_InMin               Int     @default(15)
  Accept_Appointment_Selected_Date Boolean @default(true)

  is_DND                    Boolean  @default(false)
  is_SlotCancelled          Boolean  @default(false)
  DNDremarks                String?
  Slot_cancellation_remarks String?
  isSlotChanged             Boolean  @default(false)
  isPermanentCancelled      Boolean  @default(false)
  isActive                  Boolean  @default(true)
  isDeleted                 Boolean  @default(false)
  isAvailable               Boolean  @default(true)
  isBooked                  Boolean  @default(false)
  isConfirmed               Boolean  @default(false)
  isRejected                Boolean  @default(false)
  createdBy                 Int?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

model DoctorCosting {
  DoctorCostingId      Int      @id @default(autoincrement())
  doctorId             Int
  doctor               User     @relation(fields: [doctorId], references: [UserId])
  hospitalId           Int
  hospital             Hospital @relation(fields: [hospitalId], references: [HospitalId])
  walkInFee            Float
  teleConsultFee       Float?
  fastTrackFee         Float?
  homeVisitFee         Float?
  emergencyFee         Float?
  procedureFee         Float?
  freeFollowupCount    Int?
  followupValidityDays Int?
  tax                  Float?
  discount             Float?
  commission           Float?
  discountedFee        Float?
  totalFee             Float?
  doctorPayout         Float?
  insuranceApplicable  Boolean
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  createdById          Int?
  createdBy            User?    @relation("UserCreatedDoctorCosting", fields: [createdById], references: [UserId])

  @@unique([doctorId, hospitalId])
}

model AuditLog {
  AuditLogId Int      @id @default(autoincrement())
  UserId     Int
  action     String
  entity     String
  entityId   Int?
  timestamp  DateTime @default(now())
  metadata   Json?

  user User? @relation(fields: [UserId], references: [UserId])
}

model LoginSession {
  LoginSessionId Int      @id @default(autoincrement())
  UserId         Int
  ipAddress      String
  userAgent      String
  loginAt        DateTime @default(now())

  user User @relation(fields: [UserId], references: [UserId])
}

// [User] has [roleId]
// [Role] has many [RolePermissions]
// Each [RolePermission] links a [Role] to a [Permission]

model Role {
  RoleId             Int                  @id @default(autoincrement())
  Rolename           String               @unique
  Description        String
  IsActive           Boolean              @default(true)
  Users              User[]
  UserHospitalAccess UserHospitalAccess[]
  permissions        RolePermission[] // <== Links to RolePermission
}

model RolePermission {
  RolePermissionId Int @id @default(autoincrement())
  RoleId           Int
  permissionId     Int

  // Relationships
  // There will be 5 entries in RolePermission with the same roleId but different permissionIds.
  Role       Role       @relation(fields: [RoleId], references: [RoleId])
  permission Permission @relation(fields: [permissionId], references: [PermissionId])

  @@unique([RoleId, permissionId])
}

model Permission {
  PermissionId Int              @id @default(autoincrement())
  Name         String           @unique // e.g., "Dashboard_Summary_TotalRevenueReport"
  DisplayName  String // e.g., "Total Revenue Report"
  Category     String // e.g., "Dashboard - Summary"
  Description  String?
  Roles        RolePermission[] // <== Links to RolePermission
}

model Specialization {
  SpecializationId   Int    @id @default(autoincrement())
  SpecializationName String @unique
  Description        String
  Users              User[]
}

//Appointmrnt Screen    
//PATIENT TABLE
model Patient {
  PatientId Int @id @default(autoincrement())
  // userId   Int?

  Patient_Medical_Record_No String? @unique // MRN
  // PatirntImage              String?
  // Basic Details
  profileImageUrl           String?

  Prefix            Title
  firstName         String
  lastName          String
  dateOfBirth       DateTime
  gender            String
  isQuickRegistered Boolean  @default(false) // ✅ NEW field
  // Contact Information
  mobile            String   @unique
  altContactNumber  String?
  email             String?  @unique
  addressLine1      String?
  addressLine2      String?
  area              String?
  city              String
  cityId            String? // for future relational mapping
  state             String
  country           String   @default("India")
  postalCode        Int
  landmark          String?
  taluka            String?

  // Emergency Contact
  emergencyName     String?
  emergencyContact  String?
  emergencyRelation String?

  // Kin Details
  kinName     String?
  kinContact  String?
  kinRelation String?

  // Patient Meta
  bloodGroup BloodGroup
  TagPatient TagPatient[] @relation("PatientTagPatient")

  allergies      Allergy[]        @relation("PatientAllergies")
  languages      Language[]       @relation("PatientLanguages")
  medicalHistory MedicalHistory[] @relation("PatientMedicalHistory")

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  CreatedBy   String?
  UpdatedBy   String?
  Appointment Appointment[]

  isDraft Boolean @default(false)

  //hospital and organization map
  HospitalId     Int
  OrganizationId Int

  hospital     Hospital     @relation(fields: [HospitalId], references: [HospitalId])
  organization Organization @relation(fields: [OrganizationId], references: [OrganizationId])
}

model TagPatient {
  TagPatientId   Int    @id @default(autoincrement())
  TagPatientName String @unique

  patients Patient[] @relation("PatientTagPatient")
}

model Allergy {
  AllergyId   Int       @id @default(autoincrement())
  AllergyName String    @unique
  duration    String?
  Remark      String
  patients    Patient[] @relation("PatientAllergies")
}

model Language {
  LanguageId   Int    @id @default(autoincrement())
  LanguageName String @unique

  patients Patient[] @relation("PatientLanguages")
}

model MedicalHistory {
  MedicalHistoryId   Int       @id @default(autoincrement())
  MedicalHistoryName String    @unique
  duration           String?
  Remark             String
  patients           Patient[] @relation("PatientMedicalHistory")
}

model Appointment {
  AppointmentId      Int         @id @default(autoincrement())
  PatientId          Int
  DoctorId           Int
  hospitalId         Int
  visitTypeId        Int // FK to VisitType table
  paymentTypeId      Int // FK to PaymentType table
  acuity             AcuityLevel // Enum (optional: Mild, Moderate, Critical etc.)
  AssignedProviderId Int? // Optional: link to provider (doctor)
  SpecializationId   Int? // Optional: link to specialist (doctor or category)

  appointmentDate DateTime
  reason          String?
  status          AppointmentStatus @default(SCHEDULED)
  age             Int?

  createdAt     DateTime  @default(now())
  createdBy     Int? // UserId of staff
  rescheduledAt DateTime? // If rescheduled
  rescheduledBy Int? // UserId

  // Relations
  patient           Patient @relation(fields: [PatientId], references: [PatientId])
  doctor            User    @relation("Doctor", fields: [DoctorId], references: [UserId])
  assignedProvider  User?   @relation("AssignedProvider", fields: [AssignedProviderId], references: [UserId])
  specialist        User?   @relation("Specialist", fields: [SpecializationId], references: [UserId])
  createdByUser     User?   @relation("CreatedBy", fields: [createdBy], references: [UserId])
  rescheduledByUser User?   @relation("RescheduledBy", fields: [rescheduledBy], references: [UserId])

  hospital     Hospital        @relation(fields: [hospitalId], references: [HospitalId])
  visitType    AppointmentType @relation(fields: [visitTypeId], references: [AppointmentTypeId])
  paymentType  PaymentType     @relation(fields: [paymentTypeId], references: [PaymentTypeId])
  consultation Consultation?

  isDraft Boolean @default(false)
}

model Consultation {
  ConsultationId          Int       @id @default(autoincrement())
  AppointmentId           Int       @unique
  consultationDatTime     DateTime  @default(now()) // New
  consultationEndDateTime DateTime?
  notes                   String?
  diagnosis               String?
  followUpDate            DateTime?

  vitals        Vitals?
  medications   MedicationRecord[]
  clinicalNotes ClinicalNote[]
  surgery       Surgery?

  appointment Appointment @relation(fields: [AppointmentId], references: [AppointmentId])
  isDraft     Boolean     @default(false)
}

model Vitals {
  VitalsId       Int     @id @default(autoincrement())
  consultationId Int     @unique
  BloodPressure  String?
  PulseRate      Int?
  Temperature    Float?
  Weight         Float?
  Height         Float?
  SpO2           Float?
  BloodGroup     Float?
  BMI            Float?

  consultation Consultation @relation(fields: [consultationId], references: [ConsultationId])
}

model MedicationRecord {
  MedicationRecordId Int     @id @default(autoincrement())
  consultationId     Int
  medicationName     String
  dosage             String
  frequency          String
  duration           String
  remarks            String?

  consultation Consultation @relation(fields: [consultationId], references: [ConsultationId])
}

model ClinicalNote {
  ClinicalNoteId Int    @id @default(autoincrement())
  consultationId Int
  title          String
  content        String

  consultation Consultation @relation(fields: [consultationId], references: [ConsultationId])
}

model AppointmentType {
  AppointmentTypeId   Int           @id @default(autoincrement())
  AppointmentTypeName String        @unique
  appointments        Appointment[]
}

model PaymentType {
  PaymentTypeId        Int           @id @default(autoincrement())
  TransactionId        Int
  Transaction_DateTime DateTime
  PaymentTypeName      String        @unique
  appointments         Appointment[]
}

model Surgery {
  SurgeryId      Int      @id @default(autoincrement())
  consultationId Int      @unique
  surgeryType    String
  surgeonId      Int
  surgeryDate    DateTime
  notes          String?

  consultation Consultation @relation(fields: [consultationId], references: [ConsultationId])
}

enum AcuityLevel {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

//Enums

enum HospitalLevel {
  SUPER // Top-level hospital
  CHILD // Direct child of SUPER
  SUB_CHILD // Child of a CHILD
}

enum Title {
  Mr
  Mrs
  Miss
  Ms
  Dr
  Prof
  Other
}

enum Hospital_Org_status {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SpecializationType {
  GENERAL
  OPHTHALMOLOGY
  DENTAL
  ENT
  ORTHOPEDIC
  MULTISPECIALITY
  OTHER
}

enum OrganizationType {
  HOSPITAL
  CLINIC
  DIAGNOSTICS
}

enum BloodGroup {
  A_POS  @map("A+")
  A_NEG  @map("A-")
  B_POS  @map("B+")
  B_NEG  @map("B-")
  AB_POS @map("AB+")
  AB_NEG @map("AB-")
  O_POS  @map("O+")
  O_NEG  @map("O-")
}
