model DoctorSlot {
  DoctorSlotId Int @id @default(autoincrement())

  doctorId Int
  doctor   User @relation(fields: [doctorId], references: [UserId])

  hospitalId Int
  hospital   Hospital @relation(fields: [hospitalId], references: [HospitalId])

  DoctorTimeSlotId Int
  DoctorTimeSlot   DoctorTimeSlot @relation(fields: [DoctorTimeSlotId], references: [DoctorTimeSlotId])

  slotDate  DateTime?
  slotTime  String? // 'HH:mm'
  dayOfWeek String? // 'MON', etc.

  isBooked      Boolean @default(false)
  appointmentId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([doctorId, slotDate, slotTime], name: "UniqueDoctorSlotPerDateTime")
}

model DoctorCosting {
  DoctorCostingId      Int      @id @default(autoincrement())
  doctorId             Int
  doctor               User     @relation(fields: [doctorId], references: [UserId])
  hospitalId           Int
  hospital             Hospital @relation(fields: [hospitalId], references: [HospitalId])
  walkInFee            Float
  teleConsultFee       Float?
  fastTrackFee         Float?
  homeVisitFee         Float?
  emergencyFee         Float?
  procedureFee         Float?
  freeFollowupCount    Int?
  followupValidityDays Int?
  tax                  Float?
  discount             Float?
  commission           Float?
  discountedFee        Float?
  totalFee             Float?
  doctorPayout         Float?
  insuranceApplicable  Boolean
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  createdById          Int?
  createdBy            User?    @relation("UserCreatedDoctorCosting", fields: [createdById], references: [UserId])

  @@unique([doctorId, hospitalId])
}

model AuditLog {
  AuditLogId Int      @id @default(autoincrement())
  UserId     Int
  action     String
  entity     String
  entityId   Int?
  timestamp  DateTime @default(now())
  metadata   Json?

  user User? @relation(fields: [UserId], references: [UserId])
}

model LoginSession {
  LoginSessionId Int      @id @default(autoincrement())
  UserId         Int
  ipAddress      String
  userAgent      String
  loginAt        DateTime @default(now())

  user User @relation(fields: [UserId], references: [UserId])
}

model Specialization {
  SpecializationId   Int    @id @default(autoincrement())
  SpecializationName String @unique
  Description        String
  Users              User[]

  ChiefComplaintTag ChiefComplaintTag[]

  Diagnosis Diagnosis[]

  Procedure Procedure[]
}

//Appointmrnt Screen    
//PATIENT TABLE
model Patient {
  PatientId Int @id @default(autoincrement())
  // userId   Int?

  Patient_Medical_Record_No String? @unique // MRN
  // PatirntImage              String?
  // Basic Details
  profileImageUrl           String?

  Prefix            Title
  firstName         String
  lastName          String
  dateOfBirth       DateTime
  gender            GenderType?
  isQuickRegistered Boolean     @default(false) // ✅ NEW field
  // Contact Information
  mobile            String      @unique
  altContactNumber  String?
  email             String?     @unique
  addressLine1      String?
  addressLine2      String?
  area              String?
  city              String
  cityId            String? // for future relational mapping
  state             String
  country           String      @default("India")
  postalCode        Int
  landmark          String?
  taluka            String?

  // Emergency Contact
  emergencyName     String?
  emergencyContact  String?
  emergencyRelation String?

  // Kin Details
  kinName     String?
  kinContact  String?
  kinRelation String?

  // Patient Meta
  bloodGroup BloodGroup?
  TagPatient TagPatient[] @relation("PatientTagPatient")

  allergies      Allergy[]        @relation("PatientAllergies")
  languages      Language[]       @relation("PatientLanguages")
  medicalHistory MedicalHistory[] @relation("PatientMedicalHistory")

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  CreatedBy   String?
  UpdatedBy   String?
  Appointment Appointment[]

  isDraft Boolean @default(false)

  //hospital and organization map
  HospitalId     Int
  OrganizationId Int

  hospital     Hospital     @relation(fields: [HospitalId], references: [HospitalId])
  organization Organization @relation(fields: [OrganizationId], references: [OrganizationId])
}

model TagPatient {
  TagPatientId   Int    @id @default(autoincrement())
  TagPatientName String @unique

  patients     Patient[]     @relation("PatientTagPatient")
  Appointments Appointment[] @relation("AppointmentTagPatients")
}

model Allergy {
  AllergyId   Int       @id @default(autoincrement())
  AllergyName String    @unique
  duration    String?
  Remark      String
  patients    Patient[] @relation("PatientAllergies")
}

model Language {
  LanguageId   Int    @id @default(autoincrement())
  LanguageName String @unique

  patients Patient[] @relation("PatientLanguages")
}

model MedicalHistory {
  MedicalHistoryId   Int       @id @default(autoincrement())
  IsDeleted          Boolean   @default(false)
  MedicalHistoryName String    @unique
  duration           String?
  Remark             String?
  patients           Patient[] @relation("PatientMedicalHistory")
}

model Appointment {
  AppointmentId  Int  @id @default(autoincrement())
  consultationId Int? @unique

  PatientId          Int
  DoctorId           Int
  hospitalId         Int
  visitTypeId        Int
  acuity             AcuityLevel
  AssignedProviderId Int?
  SpecializationId   Int?
  // specialization   Specialization? @relation(fields: [SpecializationId], references: [SpecializationId])

  appointmentDate    DateTime
  reason             String?
  status             AppointmentStatus @default(SCHEDULED)
  RescheduleReason   String?
  cancellationReason String?
  age                Int?

  createdAt               DateTime     @default(now())
  createdBy               Int?
  rescheduledAt           DateTime?
  rescheduledDate         DateTime? // ✅ New field
  // rescheduleReason String?
  rescheduledBy           Int?
  // TagPatientId      Int?
  TagPatients             TagPatient[] @relation("AppointmentTagPatients")
  fasttrackpatient        Boolean?     @default(false)
  IsConsultationCompleted Boolean      @default(false)
  // AppointmentAmtPaid Int?
  // isAmountPaid Boolean default(true)
  // Relations
  patient                 Patient      @relation(fields: [PatientId], references: [PatientId])
  doctor                  User         @relation("Doctor", fields: [DoctorId], references: [UserId])
  assignedProvider        User?        @relation("AssignedProvider", fields: [AssignedProviderId], references: [UserId])
  specialist              User?        @relation("Specialist", fields: [SpecializationId], references: [UserId])
  createdByUser           User?        @relation("CreatedBy", fields: [createdBy], references: [UserId])
  rescheduledByUser       User?        @relation("RescheduledBy", fields: [rescheduledBy], references: [UserId])

  hospital         Hospital        @relation(fields: [hospitalId], references: [HospitalId])
  visitType        AppointmentType @relation(fields: [visitTypeId], references: [AppointmentTypeId])
  paymentHistoryId Int? // ✅ Add this missing field
  paymentTypeId    Int

  PaymentType    PaymentType     @relation(fields: [paymentTypeId], references: [PaymentTypeId])
  paymentHistory PaymentHistory? @relation(fields: [paymentHistoryId], references: [PaymentHistoryId])

  sendWhatsappMessage Boolean                   @default(false)
  sendSmsMessage      Boolean                   @default(false)
  sendEmailMessage    Boolean                   @default(false)
  consultation        Consultation?
  isDraft             Boolean                   @default(false)
  // New relation
  notifications       AppointmentNotification[]

  Vitals Vitals[]
}

model AppointmentNotification {
  id            Int                @id @default(autoincrement())
  appointmentId Int
  channel       NotificationType
  status        NotificationStatus @default(PENDING)
  sentAt        DateTime?
  response      String?
  retryCount    Int                @default(0)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [AppointmentId])
}

model Consultation {
  ConsultationId          Int       @id @default(autoincrement())
  AppointmentId           Int       @unique
  consultationDatTime     DateTime  @default(now()) // New
  consultationEndDateTime DateTime?
  CheifcomplaintNotes     String? // Free-text from textarea
  followUpDate            DateTime?

  // vitals        Vitals?

  ConsultationMedication    ConsultationMedication[]
  ConsultationclinicalNotes ClinicalNote[]
  // surgery                   Surgery?

  appointment                Appointment                  @relation(fields: [AppointmentId], references: [AppointmentId])
  ConsultationCheifComplaint ConsultationCheifComplaint[] // Multiple complaint tags
  ConsultationInvestigation  ConsultationInvestigation[] // ✅ This is needed
  IsconsultationCompleted    Boolean?                     @default(false) // New field to track completion
  isDraft                    Boolean                      @default(false)

  ConsultationDiagnosis ConsultationDiagnosis[]

  ConsultationTreatment ConsultationTreatment[]

  ConsultationFollowUpPlan ConsultationFollowUpPlan[]

  ConsultationProcedure ConsultationProcedure[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById Int?
  createdBy   User?    @relation("ConsultationCreatedBy", fields: [createdById], references: [UserId])
  updatedById Int?
  updatedBy   User?    @relation("ConsultationUpdatedBy", fields: [updatedById], references: [UserId])
}

model Vitals {
  VitalsId         Int         @id @default(autoincrement())
  AppointmentId    Int         @unique
  Systolic         Int? // e.g. 120
  Diastolic        Int? // e.g. 80  Weight        Float?
  Weight           Float?
  Temperature      Float?
  HeartRate        Int?
  // PulseRate      Int?
  OxygenSaturation Float? //spo2
  Height           Float?
  BloodGroup       BloodGroup?
  BMI              Float?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  createdById      Int?
  createdBy        User?       @relation("VitalsCreatedBy", fields: [createdById], references: [UserId])
  appointment      Appointment @relation(fields: [AppointmentId], references: [AppointmentId])
}

model VitalsHistory {
  VitalsHistoryId  Int         @id @default(autoincrement())
  VitalsId         Int
  AppointmentId    Int
  Systolic         Int?
  Diastolic        Int?
  Weight           Float?
  Temperature      Float?
  HeartRate        Int?
  OxygenSaturation Float?
  Height           Float?
  BloodGroup       BloodGroup?
  BMI              Float?
  updatedAt        DateTime    @default(now())
  updatedById      Int?
  updatedBy        User?       @relation("VitalsUpdatedBy", fields: [updatedById], references: [UserId])
}

//master/tag list table
model ChiefComplaintTag {
  ChiefComplaintTagId    Int                          @id @default(autoincrement())
  IsDeleted              Boolean?                     @default(false)
  ChiefComplainTagName   String                       @unique
  createdAt              DateTime                     @default(now())
  specializationId       Int
  specialization         Specialization               @relation(fields: [specializationId], references: [SpecializationId])
  consultationComplaints ConsultationCheifComplaint[]
}

model ConsultationCheifComplaint {
  ConsultationComplaintId Int @id @default(autoincrement())
  ConsultationId          Int
  ChiefComplaintTagId     Int

  consultation   Consultation      @relation(fields: [ConsultationId], references: [ConsultationId], onDelete: Cascade)
  chiefComplaint ChiefComplaintTag @relation(fields: [ChiefComplaintTagId], references: [ChiefComplaintTagId], onDelete: Cascade)
}

model InvestigationType {
  InvestigationTypeId        Int                         @id @default(autoincrement())
  InvestigationTypeName      String                      @unique
  InvestigationTypeColorCode String? // Optional code for type
  InvestigationSubtypes      InvestigationSubType[]
  investigations             ConsultationInvestigation[]
}

model InvestigationSubType {
  InvestigationSubTypeId   Int                         @id @default(autoincrement())
  IsDeleted                Boolean?                    @default(false)
  InvestigationSubTypename String
  InvestigationTypeId      Int
  InvestigationType        InvestigationType           @relation(fields: [InvestigationTypeId], references: [InvestigationTypeId])
  investigations           ConsultationInvestigation[]

  @@unique([InvestigationSubTypename, InvestigationTypeId]) // Prevents duplicate subtype under same type
}

model ConsultationInvestigation {
  ConsultationInvestigationId  Int     @id @default(autoincrement())
  consultationId               Int
  InvestigationTypeId          Int
  InvestigationSubTypeId       Int
  ConsultationInvestigatRemark String?

  consultation         Consultation         @relation(fields: [consultationId], references: [ConsultationId])
  InvestigationType    InvestigationType    @relation(fields: [InvestigationTypeId], references: [InvestigationTypeId])
  InvestigationSubType InvestigationSubType @relation(fields: [InvestigationSubTypeId], references: [InvestigationSubTypeId])
}

model Medicine {
  MedicineId Int      @id @default(autoincrement())
  IsDeleted  Boolean? @default(false)

  MedicineName     String
  OnlyMedicineName String
  Strength         String?
  Units            String?
  MedicineUnitId   Int?
  ScheduleType     String?
  MedicineTypeName String?
  MedicineType     Int?
  HSNCode          String?
  Instructions     String?
  GenericName      String?
  ScheduleTypeId   Int?
  UserId           Int?
  AvailableStock   Float    @default(0)
  HospitalId       Int?
  pharmacyPrice    Float?   @default(0)
  CategoryId       Int?
  IsFrequent       String?  @default("N")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  ConsultationMedication ConsultationMedication[] // 1:N relation
}

model ConsultationMedication {
  ConsultationMedicationId Int     @id @default(autoincrement())
  consultationId           Int
  medicationId             Int?
  medicationName           String
  dosage                   String
  frequency                String
  duration                 String
  remarks                  String?

  consultation Consultation @relation(fields: [consultationId], references: [ConsultationId])
  medicine     Medicine?    @relation(fields: [medicationId], references: [MedicineId])
}

model ClinicalNote {
  ClinicalNoteId Int    @id @default(autoincrement())
  consultationId Int
  content        String

  consultation Consultation @relation(fields: [consultationId], references: [ConsultationId])
}

model Diagnosis {
  DiagnosisId      Int             @id @default(autoincrement())
  IsDeleted        Boolean?        @default(false)
  DiagnosisName    String
  icdCode          String? // optional ICD-10 or similar code
  specializationId Int?
  specialization   Specialization? @relation(fields: [specializationId], references: [SpecializationId])
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  consultations ConsultationDiagnosis[] // many-to-many (diagnosis used in multiple consultations)
}

model ConsultationDiagnosis {
  ConsultationDiagnosisId Int      @id @default(autoincrement())
  consultationId          Int
  diagnosisId             Int
  DiagnosisRemark         String? // optional doctor's remark
  createdAt               DateTime @default(now())

  consultation Consultation @relation(fields: [consultationId], references: [ConsultationId])
  diagnosis    Diagnosis    @relation(fields: [diagnosisId], references: [DiagnosisId])
}

model Procedure {
  ProcedureId      Int                     @id @default(autoincrement())
  IsDeleted        Boolean?                @default(false)
  ProcedureName    String
  ProcedureCode    String? // optional ICD-10 or similar code
  specializationId Int?
  specialization   Specialization?         @relation(fields: [specializationId], references: [SpecializationId])
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  createdBy        Int?
  consultation     ConsultationProcedure[] // many-to-many (diagnosis used in multiple consultations)
}

model ConsultationProcedure {
  ConsultationProcedureId Int      @id @default(autoincrement())
  consultationId          Int?
  Description             String? // Optional brief detail
  ProcedureId             Int?
  specializationId        Int?
  PatientId               Int?
  DoctorId                Int?
  CreatedAt               DateTime @default(now())
  CreatedBy               Int? // userId of person adding
  UpdatedAt               DateTime @updatedAt

  // Relations
  consultation Consultation? @relation(fields: [consultationId], references: [ConsultationId])

  procedure Procedure? @relation(fields: [ProcedureId], references: [ProcedureId])
}

model ConsultationTreatment {
  ConsultationTreatmentId Int             @id @default(autoincrement())
  consultationId          Int
  source                  TreatmentSource // ENUM: TYPED, DICTATED, SNIPPET
  treatmentText           String          @db.Text
  createdAt               DateTime        @default(now())

  consultation Consultation @relation(fields: [consultationId], references: [ConsultationId])
}

model ConsultationFollowUpPlan {
  id             Int           @id @default(autoincrement())
  consultationId Int           @unique
  followUpText   String? // e.g. "Review in 7 days"
  duration       Int? // e.g. 7
  unit           FollowUpUnit? // Enum: Days, Weeks, Months, Years
  nextDate       DateTime? // Optional: for calculated follow-up date
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  consultation Consultation @relation(fields: [consultationId], references: [ConsultationId])
}

model AppointmentType {
  AppointmentTypeId   Int           @id @default(autoincrement())
  AppointmentTypeName String        @unique
  appointments        Appointment[]
}

model PaymentHistory {
  PaymentHistoryId         Int         @id @default(autoincrement())
  TransactionId            BigInt
  Transaction_DateTime     DateTime
  PaymentTypeName          PaymentType @relation(fields: [paymentTypePaymentTypeId], references: [PaymentTypeId])
  ActualAppointmentCharges Float?
  DiscountOnAppointment    Float?
  FastTrackCharges         Float?

  TotalAppointmentCharges  Float?
  AppointmentChargesPaid   Float? //in case of CANCEL Appointment AppointmentChargesPaid will be 0 
  isAmountPaid             Boolean?      @default(true) // in case of CANCEL Appointment AppointmentChargesPaid will be 0 and IsAmountPaid will be 0
  appointments             Appointment[]
  paymentTypePaymentTypeId Int
}

model PaymentType {
  PaymentTypeId   Int              @id @default(autoincrement())
  PaymentTypeName String           @unique
  Appointment     Appointment[]
  PaymentHistory  PaymentHistory[]
}

model ScheduledReport {
  ScheduledReportId Int       @id @default(autoincrement())
  adminId           Int
  HospitalId        Int?
  frequency         String // "Weekly" or "Monthly"
  reportTypes       String[] // Array of selected reports
  nextRunAt         DateTime // When the next report should run
  lastRunAt         DateTime? // Last time it ran
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  Hospital          Hospital? @relation(fields: [HospitalId], references: [HospitalId])
  Admin             User      @relation(fields: [adminId], references: [UserId])
}

//Access Rights

model Module {
  ModuleId    Int         @id @default(autoincrement())
  ModuleName  String // e.g. "Dashboard"
  Description String?
  IsActive    Boolean     @default(true) // enable/disable entire module
  SubModules  SubModule[]
}

model SubModule {
  SubModuleId   Int          @id @default(autoincrement())
  ModuleId      Int
  Module        Module       @relation(fields: [ModuleId], references: [ModuleId])
  SubModuleName String // e.g. "Patient Category"
  Description   String?
  IsActive      Boolean      @default(true) // enable/disable submodule (independent toggle)
  Permissions   Permission[]
}

// [User] has [roleId]
// [Role] has many [RolePermissions]
// Each [RolePermission] links a [Role] to a [Permission]

model Role {
  RoleId             Int                  @id @default(autoincrement())
  Rolename           String               @unique
  Description        String
  IsActive           Boolean              @default(true)
  Users              User[]
  UserHospitalAccess UserHospitalAccess[]
  permissions        RolePermission[] // <== Links to RolePermission
}

model Permission {
  PermissionId Int       @id @default(autoincrement())
  SubModuleId  Int
  SubModule    SubModule @relation(fields: [SubModuleId], references: [SubModuleId])

  CanView      Boolean  @default(true)
  CanCreate    Boolean  @default(true)
  CanUpdate    Boolean  @default(true)
  CanDelete    Boolean  @default(true)
  CanExport    Boolean? @default(true)
  CanAI_Assist Boolean? @default(false)

  IsActive        Boolean          @default(true)
  RolePermissions RolePermission[]
}

model RolePermission {
  RolePermissionId Int        @id @default(autoincrement())
  RoleId           Int
  PermissionId     Int
  Role             Role       @relation(fields: [RoleId], references: [RoleId])
  Permission       Permission @relation(fields: [PermissionId], references: [PermissionId])

  // Scope (where this permission applies)
  HospitalId     Int
  OrganizationId Int
  UserId         Int

  // @@unique([RoleId, PermissionId, UserId, HospitalId, OrganizationId ])
}

