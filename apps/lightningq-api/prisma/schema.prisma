generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  UserId                                                  Int                  @id @default(autoincrement())
  Prefix                                                  Title
  imageUrl                                                String
  firstName                                               String
  lastName                                                String
  gender                                                  String
  email                                                   String               @unique
  mobile                                                  String               @unique
  passwordHash                                            String
  isActive                                                Boolean              @default(true)
  dateOfBirth                                             DateTime
  roleId                                                  Int
  SpecializationId                                        Int?
  Experience                                              String
  Employee_ID                                             String?              @unique
  SignatureOfUser                                         String
  organizationId                                          Int
  createdAt                                               DateTime             @default(now())
  createdById                                             Int?
  updatedById                                             Int?
  deletedById                                             Int?
  deletedAt                                               DateTime?
  refreshToken                                            String?
  AssignedProviderAppointment                             Appointment[]        @relation("AssignedProvider")
  DoctorAppointments                                      Appointment[]        @relation("Doctor")
  AppointmentCreatedBy                                    Appointment[]        @relation("CreatedBy")
  Appointment                                             Appointment[]        @relation("RescheduledBy")
  auditLogs                                               AuditLog[]
  BillingHistory                                          BillingHistory[]
  BillingItemCharge_BillingItemCharge_createdByToUser     BillingItemCharge[]  @relation("BillingItemCharge_createdByToUser")
  BillingItemCharge_BillingItemCharge_doctorIdToUser      BillingItemCharge[]  @relation("BillingItemCharge_doctorIdToUser")
  BillingItemCharge_BillingItemCharge_updatedByToUser     BillingItemCharge[]  @relation("BillingItemCharge_updatedByToUser")
  BillingTransaction_BillingTransaction_cancelledByToUser BillingTransaction[] @relation("BillingTransaction_cancelledByToUser")
  BillingTransaction_BillingTransaction_createdByToUser   BillingTransaction[] @relation("BillingTransaction_createdByToUser")
  BillingTransaction_BillingTransaction_doctorIdToUser    BillingTransaction[] @relation("BillingTransaction_doctorIdToUser")
  ConsultationCreatedBy                                   Consultation[]       @relation("ConsultationCreatedBy")
  ConsultationUpdatedBy                                   Consultation[]       @relation("ConsultationUpdatedBy")
  DoctorCostingCreatedBy                                  DoctorCosting[]      @relation("UserCreatedDoctorCosting")
  DoctorCosting                                           DoctorCosting[]
  DoctorSlot                                              DoctorSlot[]
  DoctorTimeSlot                                          DoctorTimeSlot[]
  HospitalCreatedBy                                       Hospital[]           @relation("UserCreatedHospitals")
  HospitalDeletedBy                                       Hospital[]           @relation("UserDeletedHospitals")
  HospitalUpdatedBy                                       Hospital[]           @relation("UserUpdatedHospitals")
  loginSessions                                           LoginSession[]
  ScheduledReport                                         ScheduledReport[]
  settings                                                Setting?             @relation("UserSettings")
  Specialization                                          Specialization?      @relation(fields: [SpecializationId], references: [SpecializationId])
  createdBy                                               User?                @relation("UserCreatedUsers", fields: [createdById], references: [UserId])
  createdUsers                                            User[]               @relation("UserCreatedUsers")
  deletedBy                                               User?                @relation("UserDeletedUsers", fields: [deletedById], references: [UserId])
  deletedUsers                                            User[]               @relation("UserDeletedUsers")
  organization                                            Organization         @relation(fields: [organizationId], references: [OrganizationId])
  role                                                    Role                 @relation(fields: [roleId], references: [RoleId])
  updatedBy                                               User?                @relation("UserUpdatedUsers", fields: [updatedById], references: [UserId])
  updatedUsers                                            User[]               @relation("UserUpdatedUsers")
  AdminAccess                                             UserHospitalAccess[] @relation("UserAdminAccess")
  UserHospitalAccess                                      UserHospitalAccess[] @relation("CreatedUserHospitalAccess")
  VitalsCreatedBy                                         Vitals[]             @relation("VitalsCreatedBy")
  VitalsHistoryUpdatedBy                                  VitalsHistory[]      @relation("VitalsUpdatedBy")
  ConsultationSpecialist                                  Appointment[]        @relation("Specialist")
  UserBranchesArray                                       Hospital[]           @relation("UserHospitals")
}

model Organization {
  OrganizationId     Int                  @id @default(autoincrement())
  OrganizationName   String
  Organizationcode   String               @unique
  logoUrl            String
  email              String               @unique
  contactNumber      String
  Orgnizationtype    OrganizationType?
  website            String
  addressLine1       String
  addressLine2       String
  city               String
  state              String
  country            String
  postalCode         String
  registrationNo     String
  establishedOn      DateTime
  industryType       String
  status             Hospital_Org_status  @default(ACTIVE)
  description        String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @default(now())
  isActive           Boolean?             @default(true)
  BillingTransaction BillingTransaction[]
  hospitals          Hospital[]
  Patient            Patient[]
  users              User[]
  UserHospitalAccess UserHospitalAccess[]
}

model Hospital {
  HospitalId         Int                  @id @default(autoincrement())
  HospitalName       String
  HospitalCode       String               @unique
  ParentHospitalCode String
  Organizationcode   String
  SpecializationType SpecializationType
  address            String
  city               String
  state              String
  country            String
  postalCode         String
  contactNumber      String
  email              String
  website            String
  logoUrl            String
  latitude           Float
  longitude          Float
  status             Hospital_Org_status  @default(ACTIVE)
  level              HospitalLevel?
  parentHospitalId   Int?
  organizationId     Int
  isActive           Boolean              @default(true)
  createdById        Int?
  updatedById        Int?
  deletedById        Int?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @default(now())
  deletedAt          DateTime?
  Appointment        Appointment[]
  BillingItemCharge  BillingItemCharge[]
  BillingTransaction BillingTransaction[]
  DoctorCosting      DoctorCosting[]
  DoctorSlot         DoctorSlot[]
  DoctorTimeSlot     DoctorTimeSlot[]
  CreatedBy          User?                @relation("UserCreatedHospitals", fields: [createdById], references: [UserId])
  DeletedBy          User?                @relation("UserDeletedHospitals", fields: [deletedById], references: [UserId])
  Organization       Organization         @relation(fields: [organizationId], references: [OrganizationId])
  parentHospital     Hospital?            @relation("HospitalHierarchy", fields: [parentHospitalId], references: [HospitalId])
  childHospital      Hospital[]           @relation("HospitalHierarchy")
  UpdatedBy          User?                @relation("UserUpdatedHospitals", fields: [updatedById], references: [UserId])
  Patient            Patient[]
  ScheduledReport    ScheduledReport[]
  users              UserHospitalAccess[]
  mappedUsers        User[]               @relation("UserHospitals")
}

model UserHospitalAccess {
  UserHospitalAccessId Int           @id @default(autoincrement())
  UserId               Int
  hospitalId           Int
  roleId               Int
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @default(now())
  createdById          Int?
  OrganizationId       Int?
  Organization         Organization? @relation(fields: [OrganizationId], references: [OrganizationId])
  User                 User          @relation("UserAdminAccess", fields: [UserId], references: [UserId])
  createdBy            User?         @relation("CreatedUserHospitalAccess", fields: [createdById], references: [UserId])
  hospital             Hospital      @relation(fields: [hospitalId], references: [HospitalId])
  role                 Role          @relation(fields: [roleId], references: [RoleId])

  @@unique([UserId, hospitalId, roleId])
}

model DoctorTimeSlotHistory {
  DoctorTimeSlotHistoryId          Int      @id @default(autoincrement())
  DoctorTimeSlotId                 Int?
  userId                           Int
  HospitalId                       Int
  DayOfWeek                        String
  Morning_From                     String?
  Morning_To                       String?
  Evening_From                     String?
  Evening_To                       String?
  consult_Time_InMin               Int
  Accept_Appointment_Selected_Date Boolean
  is_DND                           Boolean
  is_SlotCancelled                 Boolean
  isPermanentCancelled             Boolean
  DNDremarks                       String?
  Slot_cancellation_remarks        String?
  isDeleted                        Boolean
  isAvailable                      Boolean
  isBooked                         Boolean
  isConfirmed                      Boolean
  isRejected                       Boolean
  createdAt                        DateTime
  updatedAt                        DateTime
  changedAt                        DateTime @default(now())
  changedBy                        Int
  isSlotChanged                    Boolean?
  isActive                         Boolean  @default(true)
  createdBy                        Int?
}

model Setting {
  SettingId Int    @id @default(autoincrement())
  UserId    Int    @unique
  theme     String @default("light")
  language  String @default("en")
  user      User   @relation("UserSettings", fields: [UserId], references: [UserId])
}

model DoctorTimeSlot {
  DoctorTimeSlotId                 Int          @id @default(autoincrement())
  DoctorId                         Int
  HospitalId                       Int
  DayOfWeek                        String
  Morning_From                     String?
  Morning_To                       String?
  Evening_From                     String?
  Evening_To                       String?
  consult_Time_InMin               Int          @default(15)
  Accept_Appointment_Selected_Date Boolean      @default(true)
  is_DND                           Boolean      @default(false)
  is_SlotCancelled                 Boolean      @default(false)
  DNDremarks                       String?
  Slot_cancellation_remarks        String?
  isSlotChanged                    Boolean      @default(false)
  isPermanentCancelled             Boolean      @default(false)
  isActive                         Boolean      @default(true)
  isDeleted                        Boolean      @default(false)
  isAvailable                      Boolean      @default(true)
  isBooked                         Boolean      @default(false)
  isConfirmed                      Boolean      @default(false)
  isRejected                       Boolean      @default(false)
  createdBy                        Int?
  createdAt                        DateTime     @default(now())
  updatedAt                        DateTime     @updatedAt
  SlotsDateTime                    DoctorSlot[]
  Doctor                           User         @relation(fields: [DoctorId], references: [UserId], onDelete: Cascade)
  Hospital                         Hospital     @relation(fields: [HospitalId], references: [HospitalId], onDelete: Cascade)
}

model DoctorSlot {
  DoctorSlotId     Int            @id @default(autoincrement())
  doctorId         Int
  hospitalId       Int
  DoctorTimeSlotId Int
  slotDate         DateTime?
  slotTime         String?
  dayOfWeek        String?
  isBooked         Boolean        @default(false)
  appointmentId    Int?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  DoctorTimeSlot   DoctorTimeSlot @relation(fields: [DoctorTimeSlotId], references: [DoctorTimeSlotId])
  doctor           User           @relation(fields: [doctorId], references: [UserId])
  hospital         Hospital       @relation(fields: [hospitalId], references: [HospitalId])

  @@unique([doctorId, slotDate, slotTime], name: "UniqueDoctorSlotPerDateTime")
}

model DoctorCosting {
  DoctorCostingId      Int      @id @default(autoincrement())
  doctorId             Int
  hospitalId           Int
  walkInFee            Float
  teleConsultFee       Float?
  fastTrackFee         Float?
  homeVisitFee         Float?
  emergencyFee         Float?
  procedureFee         Float?
  freeFollowupCount    Int?
  followupValidityDays Int?
  tax                  Float?
  discount             Float?
  commission           Float?
  discountedFee        Float?
  totalFee             Float?
  doctorPayout         Float?
  insuranceApplicable  Boolean
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  createdById          Int?
  createdBy            User?    @relation("UserCreatedDoctorCosting", fields: [createdById], references: [UserId])
  doctor               User     @relation(fields: [doctorId], references: [UserId])
  hospital             Hospital @relation(fields: [hospitalId], references: [HospitalId])

  @@unique([doctorId, hospitalId])
}

model AuditLog {
  AuditLogId Int      @id @default(autoincrement())
  UserId     Int
  action     String
  entity     String
  entityId   Int?
  timestamp  DateTime @default(now())
  metadata   Json?
  user       User     @relation(fields: [UserId], references: [UserId])
}

model LoginSession {
  LoginSessionId Int      @id @default(autoincrement())
  UserId         Int
  ipAddress      String
  userAgent      String
  loginAt        DateTime @default(now())
  user           User     @relation(fields: [UserId], references: [UserId])
}

model Specialization {
  SpecializationId   Int                 @id @default(autoincrement())
  SpecializationName String              @unique
  Description        String
  Appointment        Appointment[]
  BillingItemCharge  BillingItemCharge[]
  ChiefComplaintTag  ChiefComplaintTag[]
  Diagnosis          Diagnosis[]
  Procedure          Procedure[]
  Users              User[]
}

model Patient {
  PatientId                 Int                   @id @default(autoincrement())
  Patient_Medical_Record_No String?               @unique
  profileImageUrl           String?
  Prefix                    Title
  firstName                 String
  lastName                  String
  dateOfBirth               DateTime
  gender                    GenderType?
  isQuickRegistered         Boolean               @default(false)
  mobile                    String                @unique
  altContactNumber          String?
  email                     String?               @unique
  addressLine1              String?
  addressLine2              String?
  area                      String?
  city                      String
  cityId                    String?
  state                     String
  country                   String                @default("India")
  postalCode                Int
  landmark                  String?
  taluka                    String?
  emergencyName             String?
  emergencyContact          String?
  emergencyRelation         String?
  kinName                   String?
  kinContact                String?
  kinRelation               String?
  bloodGroup                BloodGroup?
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  CreatedBy                 String?
  UpdatedBy                 String?
  isDraft                   Boolean               @default(false)
  HospitalId                Int
  OrganizationId            Int
  Appointment               Appointment[]
  BillingTransaction        BillingTransaction[]
  hospital                  Hospital              @relation(fields: [HospitalId], references: [HospitalId])
  organization              Organization          @relation(fields: [OrganizationId], references: [OrganizationId])
  PatientPackageUsage       PatientPackageUsage[]
  allergies                 Allergy[]             @relation("PatientAllergies")
  languages                 Language[]            @relation("PatientLanguages")
  medicalHistory            MedicalHistory[]      @relation("PatientMedicalHistory")
  TagPatient                TagPatient[]          @relation("PatientTagPatient")
}

model TagPatient {
  TagPatientId   Int           @id @default(autoincrement())
  TagPatientName String        @unique
  Appointments   Appointment[] @relation("AppointmentTagPatients")
  patients       Patient[]     @relation("PatientTagPatient")
}

model Allergy {
  AllergyId   Int       @id @default(autoincrement())
  AllergyName String    @unique
  duration    String?
  Remark      String
  patients    Patient[] @relation("PatientAllergies")
}

model Language {
  LanguageId   Int       @id @default(autoincrement())
  LanguageName String    @unique
  patients     Patient[] @relation("PatientLanguages")
}

model MedicalHistory {
  MedicalHistoryId   Int       @id @default(autoincrement())
  MedicalHistoryName String    @unique
  duration           String?
  Remark             String?
  IsDeleted          Boolean   @default(false)
  patients           Patient[] @relation("PatientMedicalHistory")
}

model Appointment {
  AppointmentId       Int                       @id @default(autoincrement())
  consultationId      Int?                      @unique
  PatientId           Int
  DoctorId            Int
  hospitalId          Int
  visitTypeId         Int
  acuity              AcuityLevel
  AssignedProviderId  Int?
  SpecializationId    Int?
  appointmentDate     DateTime
  reason              String?
  status              AppointmentStatus         @default(SCHEDULED)
  RescheduleReason    String?
  cancellationReason  String?
  age                 Int?
  createdAt           DateTime                  @default(now())
  createdBy           Int?
  rescheduledAt       DateTime?
  rescheduledDate     DateTime?
  rescheduledBy       Int?
  paymentHistoryId    Int?
  paymentTypeId       Int
  sendWhatsappMessage Boolean                   @default(false)
  sendSmsMessage      Boolean                   @default(false)
  sendEmailMessage    Boolean                   @default(false)
  isDraft             Boolean                   @default(false)
  fasttrackpatient    Boolean?                  @default(false)
  consultationStatus  ConsultationStatus        @default(NOT_STARTED)
  assignedProvider    User?                     @relation("AssignedProvider", fields: [AssignedProviderId], references: [UserId])
  doctor              User                      @relation("Doctor", fields: [DoctorId], references: [UserId])
  patient             Patient                   @relation(fields: [PatientId], references: [PatientId])
  specialization      Specialization?           @relation(fields: [SpecializationId], references: [SpecializationId])
  createdByUser       User?                     @relation("CreatedBy", fields: [createdBy], references: [UserId])
  hospital            Hospital                  @relation(fields: [hospitalId], references: [HospitalId])
  paymentHistory      PaymentHistory?           @relation(fields: [paymentHistoryId], references: [PaymentHistoryId])
  PaymentType         PaymentType               @relation(fields: [paymentTypeId], references: [PaymentTypeId])
  rescheduledByUser   User?                     @relation("RescheduledBy", fields: [rescheduledBy], references: [UserId])
  visitType           AppointmentType           @relation(fields: [visitTypeId], references: [AppointmentTypeId])
  notifications       AppointmentNotification[]
  BillingTransaction  BillingTransaction[]
  consultation        Consultation?
  PatientPackageUsage PatientPackageUsage[]
  Vitals              Vitals?
  TagPatients         TagPatient[]              @relation("AppointmentTagPatients")
  User                User[]                    @relation("Specialist")
}

model AppointmentNotification {
  id            Int                @id @default(autoincrement())
  appointmentId Int
  channel       NotificationType
  status        NotificationStatus @default(PENDING)
  sentAt        DateTime?
  response      String?
  retryCount    Int                @default(0)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  appointment   Appointment        @relation(fields: [appointmentId], references: [AppointmentId])
}

model Consultation {
  ConsultationId             Int                          @id @default(autoincrement())
  AppointmentId              Int                          @unique
  consultationDatTime        DateTime                     @default(now())
  consultationEndDateTime    DateTime?
  CheifcomplaintNotes        String?
  followUpDate               DateTime?
  isDraft                    Boolean                      @default(false)
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  createdById                Int?
  updatedById                Int?
  consultationStatus         ConsultationStatus           @default(NOT_STARTED)
  ConsultationclinicalNotes  ClinicalNote[]
  appointment                Appointment                  @relation(fields: [AppointmentId], references: [AppointmentId])
  createdBy                  User?                        @relation("ConsultationCreatedBy", fields: [createdById], references: [UserId])
  updatedBy                  User?                        @relation("ConsultationUpdatedBy", fields: [updatedById], references: [UserId])
  ConsultationCheifComplaint ConsultationCheifComplaint[]
  ConsultationDiagnosis      ConsultationDiagnosis[]
  ConsultationFollowUpPlan   ConsultationFollowUpPlan?
  ConsultationInvestigation  ConsultationInvestigation[]
  ConsultationMedication     ConsultationMedication[]
  ConsultationProcedure      ConsultationProcedure[]
  ConsultationTreatment      ConsultationTreatment[]
  PatientPackageUsage        PatientPackageUsage[]
}

model Vitals {
  VitalsId         Int         @id @default(autoincrement())
  AppointmentId    Int         @unique
  Systolic         Int?
  Diastolic        Int?
  Weight           Float?
  Temperature      Float?
  HeartRate        Int?
  OxygenSaturation Float?
  Height           Float?
  BloodGroup       BloodGroup?
  BMI              Float?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  createdById      Int?
  appointment      Appointment @relation(fields: [AppointmentId], references: [AppointmentId])
  createdBy        User?       @relation("VitalsCreatedBy", fields: [createdById], references: [UserId])
}

model VitalsHistory {
  VitalsHistoryId  Int         @id @default(autoincrement())
  VitalsId         Int
  AppointmentId    Int
  Systolic         Int?
  Diastolic        Int?
  Weight           Float?
  Temperature      Float?
  HeartRate        Int?
  OxygenSaturation Float?
  Height           Float?
  BloodGroup       BloodGroup?
  BMI              Float?
  updatedAt        DateTime    @default(now())
  updatedById      Int?
  updatedBy        User?       @relation("VitalsUpdatedBy", fields: [updatedById], references: [UserId])
}

model ChiefComplaintTag {
  ChiefComplaintTagId    Int                          @id @default(autoincrement())
  ChiefComplainTagName   String                       @unique
  createdAt              DateTime                     @default(now())
  specializationId       Int
  IsDeleted              Boolean?                     @default(false)
  specialization         Specialization               @relation(fields: [specializationId], references: [SpecializationId])
  consultationComplaints ConsultationCheifComplaint[]
}

model ConsultationCheifComplaint {
  ConsultationComplaintId Int               @id @default(autoincrement())
  ConsultationId          Int
  ChiefComplaintTagId     Int
  chiefComplaint          ChiefComplaintTag @relation(fields: [ChiefComplaintTagId], references: [ChiefComplaintTagId], onDelete: Cascade)
  consultation            Consultation      @relation(fields: [ConsultationId], references: [ConsultationId], onDelete: Cascade)
}

model InvestigationType {
  InvestigationTypeId        Int                    @id @default(autoincrement())
  InvestigationTypeName      String                 @unique
  InvestigationTypeColorCode String?
  BillingItemCharge          BillingItemCharge[]
  InvestigationSubtypes      InvestigationSubType[]
}

model InvestigationSubType {
  InvestigationSubTypeId   Int               @id @default(autoincrement())
  InvestigationSubTypename String
  InvestigationTypeId      Int
  IsDeleted                Boolean?          @default(false)
  InvestigationType        InvestigationType @relation(fields: [InvestigationTypeId], references: [InvestigationTypeId])

  @@unique([InvestigationSubTypename, InvestigationTypeId])
}

model ConsultationInvestigation {
  ConsultationInvestigationId  Int                @id @default(autoincrement())
  consultationId               Int
  ConsultationInvestigatRemark String?
  BillingItemChargeId          Int?
  BillingItemCharge            BillingItemCharge? @relation(fields: [BillingItemChargeId], references: [BillingItemChargeId])
  consultation                 Consultation       @relation(fields: [consultationId], references: [ConsultationId])
}

model Medicine {
  MedicineId             Int                      @id @default(autoincrement())
  MedicineName           String
  OnlyMedicineName       String
  Strength               String?
  Units                  String?
  MedicineUnitId         Int?
  ScheduleType           String?
  MedicineTypeName       String?
  MedicineType           Int?
  HSNCode                String?
  Instructions           String?
  GenericName            String?
  ScheduleTypeId         Int?
  UserId                 Int?
  AvailableStock         Float                    @default(0)
  HospitalId             Int?
  pharmacyPrice          Float?                   @default(0)
  CategoryId             Int?
  IsFrequent             String?                  @default("N")
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  IsDeleted              Boolean?                 @default(false)
  ConsultationMedication ConsultationMedication[]
}

model ConsultationMedication {
  ConsultationMedicationId Int          @id @default(autoincrement())
  consultationId           Int
  medicationId             Int?
  medicationName           String
  dosage                   String
  frequency                String
  duration                 String
  remarks                  String?
  consultation             Consultation @relation(fields: [consultationId], references: [ConsultationId])
  medicine                 Medicine?    @relation(fields: [medicationId], references: [MedicineId])
}

model ClinicalNote {
  ClinicalNoteId Int          @id @default(autoincrement())
  consultationId Int
  content        String
  consultation   Consultation @relation(fields: [consultationId], references: [ConsultationId])
}

model Diagnosis {
  DiagnosisId      Int                     @id @default(autoincrement())
  DiagnosisName    String
  icdCode          String?
  specializationId Int?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  IsDeleted        Boolean?                @default(false)
  consultations    ConsultationDiagnosis[]
  specialization   Specialization?         @relation(fields: [specializationId], references: [SpecializationId])
}

model ConsultationDiagnosis {
  ConsultationDiagnosisId Int          @id @default(autoincrement())
  consultationId          Int
  diagnosisId             Int
  DiagnosisRemark         String?
  createdAt               DateTime     @default(now())
  consultation            Consultation @relation(fields: [consultationId], references: [ConsultationId])
  diagnosis               Diagnosis    @relation(fields: [diagnosisId], references: [DiagnosisId])
}

model Procedure {
  ProcedureId      Int             @id @default(autoincrement())
  ProcedureName    String
  ProcedureCode    String?
  specializationId Int?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  createdBy        Int?
  IsDeleted        Boolean?        @default(false)
  specialization   Specialization? @relation(fields: [specializationId], references: [SpecializationId])
}

model ConsultationProcedure {
  ConsultationProcedureId Int      @id @default(autoincrement())
  consultationId          Int
  specializationId        Int?
  PatientId               Int?
  DoctorId                Int?
  CreatedAt               DateTime @default(now())
  CreatedBy               Int?
  UpdatedAt               DateTime @updatedAt

  BillingItemChargeId         Int // REQUIRED
  ConsultationProcedureRemark String?

  BillingItemCharge BillingItemCharge @relation(fields: [BillingItemChargeId], references: [BillingItemChargeId])
  consultation      Consultation      @relation(fields: [consultationId], references: [ConsultationId])
}

model ConsultationTreatment {
  ConsultationTreatmentId Int             @id @default(autoincrement())
  consultationId          Int
  source                  TreatmentSource
  treatmentText           String
  createdAt               DateTime        @default(now())
  consultation            Consultation    @relation(fields: [consultationId], references: [ConsultationId])
}

model ConsultationFollowUpPlan {
  id             Int           @id @default(autoincrement())
  consultationId Int           @unique
  followUpText   String?
  duration       Int?
  unit           FollowUpUnit?
  nextDate       DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  consultation   Consultation  @relation(fields: [consultationId], references: [ConsultationId])
}

model AppointmentType {
  AppointmentTypeId   Int                 @id @default(autoincrement())
  AppointmentTypeName String              @unique
  appointments        Appointment[]
  BillingItemCharge   BillingItemCharge[]
}

model PaymentHistory {
  PaymentHistoryId         Int           @id @default(autoincrement())
  TransactionId            BigInt
  Transaction_DateTime     DateTime
  AppointmentChargesPaid   Float?
  isAmountPaid             Boolean?      @default(true)
  paymentTypePaymentTypeId Int
  TotalAppointmentCharges  Float?
  ActualAppointmentCharges Float?
  DiscountOnAppointment    Float?
  FastTrackCharges         Float?
  appointments             Appointment[]
  PaymentTypeName          PaymentType   @relation(fields: [paymentTypePaymentTypeId], references: [PaymentTypeId])
}

model PaymentType {
  PaymentTypeId   Int              @id @default(autoincrement())
  PaymentTypeName String           @unique
  Appointment     Appointment[]
  PaymentHistory  PaymentHistory[]
}

model ScheduledReport {
  ScheduledReportId Int       @id @default(autoincrement())
  adminId           Int
  frequency         String
  reportTypes       String[]
  nextRunAt         DateTime
  lastRunAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  HospitalId        Int?
  Hospital          Hospital? @relation(fields: [HospitalId], references: [HospitalId])
  Admin             User      @relation(fields: [adminId], references: [UserId])
}

model Module {
  ModuleId    Int         @id @default(autoincrement())
  ModuleName  String
  Description String?
  IsActive    Boolean     @default(true)
  SubModules  SubModule[]
}

model SubModule {
  SubModuleId   Int          @id @default(autoincrement())
  ModuleId      Int
  SubModuleName String
  Description   String?
  IsActive      Boolean      @default(true)
  Permissions   Permission[]
  Module        Module       @relation(fields: [ModuleId], references: [ModuleId])
}

model Role {
  RoleId             Int                  @id @default(autoincrement())
  Rolename           String               @unique
  Description        String
  IsActive           Boolean              @default(true)
  permissions        RolePermission[]
  Users              User[]
  UserHospitalAccess UserHospitalAccess[]
}

model Permission {
  PermissionId    Int              @id @default(autoincrement())
  CanAI_Assist    Boolean?         @default(false)
  CanCreate       Boolean          @default(true)
  CanDelete       Boolean          @default(true)
  CanExport       Boolean?         @default(true)
  CanUpdate       Boolean          @default(true)
  CanView         Boolean          @default(true)
  IsActive        Boolean          @default(true)
  SubModuleId     Int
  SubModule       SubModule        @relation(fields: [SubModuleId], references: [SubModuleId])
  RolePermissions RolePermission[]
}

model RolePermission {
  RolePermissionId Int        @id @default(autoincrement())
  RoleId           Int
  HospitalId       Int
  OrganizationId   Int
  PermissionId     Int
  UserId           Int
  Permission       Permission @relation(fields: [PermissionId], references: [PermissionId])
  Role             Role       @relation(fields: [RoleId], references: [RoleId])
}

model BillItemType {
  BillItemTypeId    Int                 @id @default(autoincrement())
  description       String?
  color             String?
  icon              String?
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  BillItemTypeName  String              @unique
  BillingItemCharge BillingItemCharge[]
}

model BillStatus {
  BillStatusId       Int                  @id @default(autoincrement())
  StatusName         String               @unique
  Description        String?
  colorCode          String?
  isActive           Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  BillingTransaction BillingTransaction[]
}

model BillingHistory {
  BillingHistoryId      Int                     @id @default(autoincrement())
  BillingTransactionId  Int
  historyType           String
  snapshot              Json
  remarks               String?
  createdBy             Int?
  createdAt             DateTime                @default(now())
  BillingTransaction    BillingTransaction      @relation(fields: [BillingTransactionId], references: [BillingTransactionId])
  User                  User?                   @relation(fields: [createdBy], references: [UserId])
  BillingHistoryDetails BillingHistoryDetails[]
}

model BillingHistoryDetails {
  HistoryDetailsId    Int                  @id @default(autoincrement())
  BillingHistoryId    Int
  BilledCost          Decimal              @default(0) @db.Decimal(10, 2)
  TotalAmountReceived Decimal              @default(0) @db.Decimal(10, 2)
  InvoiceId           String
  OldInvoiceId        String?
  ReceiptId           String?
  ReceiptNo           String?
  BillingRemarks      String?
  TotalRoundOff       Decimal              @default(0) @db.Decimal(10, 2)
  RoundOffType        String?
  CreatedDt           DateTime             @default(now())
  CreatedByName       String?
  HospitalId          Int
  BranchName          String?
  BranchMobile        String?
  BranchEmail         String?
  BranchPincode       String?
  Address1            String?
  Address2            String?
  Address3            String?
  GSTNo               String?
  AreaCode            String?
  deleteInd           Int                  @default(0)
  BillingHistory      BillingHistory       @relation(fields: [BillingHistoryId], references: [BillingHistoryId])
  HistoryPaymentInfo  HistoryPaymentInfo[]
}

model BillingItemCharge {
  BillingItemChargeId                    Int                         @id @default(autoincrement())
  code                                   String?
  description                            String?
  hospitalId                             Int
  specializationId                       Int?
  maxDiscountPercent                     Int?                        @default(0)
  isActive                               Boolean                     @default(true)
  createdAt                              DateTime                    @default(now())
  updatedAt                              DateTime
  createdBy                              Int?
  updatedBy                              Int?
  BillingItemName                        String                      
  price                                  Decimal?                    @db.Decimal(10, 2)
  doctorId                               Int?
  fastTrackCharges                       Decimal?                    @db.Decimal(10, 2)
  followupValidity                       Int?                        @default(0)
  numberOfFollowups                      Int?                        @default(0)
  telePrice                              Decimal?                    @db.Decimal(10, 2)
  walkinPrice                            Decimal?                    @db.Decimal(10, 2)
  maxDiscountInr                         Decimal?                    @default(0) @db.Decimal(10, 2)
  appointmentTypeId                      Int?
  chargeTypeId                           Int?
  investigationTypeId                    Int?
  AppointmentType                        AppointmentType?            @relation(fields: [appointmentTypeId], references: [AppointmentTypeId])
  chargeType                             BillItemType?               @relation(fields: [chargeTypeId], references: [BillItemTypeId])
  User_BillingItemCharge_createdByToUser User?                       @relation("BillingItemCharge_createdByToUser", fields: [createdBy], references: [UserId])
  User_BillingItemCharge_doctorIdToUser  User?                       @relation("BillingItemCharge_doctorIdToUser", fields: [doctorId], references: [UserId])
  Hospital                               Hospital                    @relation(fields: [hospitalId], references: [HospitalId])
  InvestigationType                      InvestigationType?          @relation(fields: [investigationTypeId], references: [InvestigationTypeId])
  Specialization                         Specialization?             @relation(fields: [specializationId], references: [SpecializationId])
  User_BillingItemCharge_updatedByToUser User?                       @relation("BillingItemCharge_updatedByToUser", fields: [updatedBy], references: [UserId])
  BillingTransactionItem                 BillingTransactionItem[]
  ConsultationInvestigation              ConsultationInvestigation[]
  ConsultationProcedure                  ConsultationProcedure[]
  PatientPackageUsage                    PatientPackageUsage[]
  @@unique([BillingItemName, hospitalId, doctorId, appointmentTypeId])

}

model BillingPayment {
  BillingPaymentId     Int                @id @default(autoincrement())
  billingTransactionId Int
  paymentMode          String
  amount               Decimal            @db.Decimal(10, 2)
  referenceNumber      String?
  remarks              String?
  createdAt            DateTime           @default(now())
  InvoiceId            String?
  PaymentReceptNo      String?
  BillingTransaction   BillingTransaction @relation(fields: [billingTransactionId], references: [BillingTransactionId])
}

model BillingTransaction {
  BillingTransactionId                      Int                      @id @default(autoincrement())
  OPInvoiceNo                               String                   @unique
  billType                                  String                   @default("OPD")
  billDate                                  DateTime                 @default(now())
  patientId                                 Int
  appointmentId                             Int?
  hospitalId                                Int
  organizationId                            Int
  doctorId                                  Int
  createdBy                                 Int?
  cancelledBy                               Int?
  subtotal                                  Decimal                  @db.Decimal(10, 2)
  totalDiscount                             Decimal                  @default(0) @db.Decimal(10, 2)
  totalTax                                  Decimal                  @default(0) @db.Decimal(10, 2)
  overallDiscountType                       String?
  overallDiscountValue                      Decimal?                 @default(0) @db.Decimal(10, 2)
  netAmount                                 Decimal                  @db.Decimal(10, 2)
  amountPaid                                Decimal                  @default(0) @db.Decimal(10, 2)
  balanceDue                                Decimal                  @default(0) @db.Decimal(10, 2)
  paymentStatusId                           Int
  billStatusId                              Int
  remarks                                   String?
  cancelledAt                               DateTime?
  createdAt                                 DateTime                 @default(now())
  updatedAt                                 DateTime
  BillingHistory                            BillingHistory[]
  BillingPayment                            BillingPayment[]
  Appointment                               Appointment?             @relation(fields: [appointmentId], references: [AppointmentId])
  BillStatus                                BillStatus               @relation(fields: [billStatusId], references: [BillStatusId])
  User_BillingTransaction_cancelledByToUser User?                    @relation("BillingTransaction_cancelledByToUser", fields: [cancelledBy], references: [UserId])
  User_BillingTransaction_createdByToUser   User?                    @relation("BillingTransaction_createdByToUser", fields: [createdBy], references: [UserId])
  User_BillingTransaction_doctorIdToUser    User                     @relation("BillingTransaction_doctorIdToUser", fields: [doctorId], references: [UserId])
  Hospital                                  Hospital                 @relation(fields: [hospitalId], references: [HospitalId])
  Organization                              Organization             @relation(fields: [organizationId], references: [OrganizationId])
  Patient                                   Patient                  @relation(fields: [patientId], references: [PatientId])
  PaymentStatus                             PaymentStatus            @relation(fields: [paymentStatusId], references: [PaymentStatusId])
  BillingTransactionItem                    BillingTransactionItem[]
}

model BillingTransactionItem {
  BillingTransactionItemId Int @id @default(autoincrement())
  billingTransactionId     Int

  billingItemChargeId Int // REQUIRED

  itemName       String
  chargeType     String?
  units          Int      @default(1)
  price          Decimal  @db.Decimal(10, 2)
  discountType   String?
  discountValue  Decimal? @default(0) @db.Decimal(10, 2)
  discountAmount Decimal  @default(0) @db.Decimal(10, 2)
  gstType        String?
  gstValue       Decimal? @default(0) @db.Decimal(10, 2)
  gstAmount      Decimal  @default(0) @db.Decimal(10, 2)
  totalAmount    Decimal  @db.Decimal(10, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime

  BillingItemCharge  BillingItemCharge  @relation(fields: [billingItemChargeId], references: [BillingItemChargeId])
  BillingTransaction BillingTransaction @relation(fields: [billingTransactionId], references: [BillingTransactionId])
}

model HistoryPaymentInfo {
  HistoryPaymentInfoId    Int                   @id @default(autoincrement())
  BillingHistoryDetailsId Int
  PaymentModeId           Int?
  PaymentModeName         String?
  BankName                String?
  CardNumber              String?
  TransactionNumber       String?
  CardTypeId              Int?
  CardType                String?
  Amount                  Decimal               @default(0) @db.Decimal(10, 2)
  ChequeNumber            String?
  NameOnCard              String?
  ValidTill               String?
  DisallowanceAmount      Decimal               @default(0) @db.Decimal(10, 2)
  ModifiedBy              String?
  InsuranceAdvanceAmount  Decimal               @default(0) @db.Decimal(10, 2)
  PaymentReceiptNo        String?
  BillingHistoryDetails   BillingHistoryDetails @relation(fields: [BillingHistoryDetailsId], references: [HistoryDetailsId])
}

model PatientPackageUsage {
  PatientPackageUsageId Int      @id @default(autoincrement())
  patientId             Int
  appointmentId         Int?
  consultationId        Int?
  usageDate             DateTime @default(now())
  status                String   @default("Incomplete")
  createdAt             DateTime @default(now())
  updatedAt             DateTime

  billingItemChargeId Int // REQUIRED

  IsFastTrack    Boolean @default(false)
  IsFreeFollowUp Boolean @default(false)

  Appointment       Appointment?      @relation(fields: [appointmentId], references: [AppointmentId])
  BillingItemCharge BillingItemCharge @relation(fields: [billingItemChargeId], references: [BillingItemChargeId])
  Consultation      Consultation?     @relation(fields: [consultationId], references: [ConsultationId])
  Patient           Patient           @relation(fields: [patientId], references: [PatientId])
}

model PaymentStatus {
  PaymentStatusId    Int                  @id @default(autoincrement())
  StatusName         String               @unique
  Description        String?
  colorCode          String?
  isActive           Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  BillingTransaction BillingTransaction[]
}

