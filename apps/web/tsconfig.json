{
  "extends": "@repo/typescript-config/nextjs.json",
  "compilerOptions": {
    
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    "next.config.js",
    ".next/types/**/*.ts",
    "types/custom.d.ts",
    "src/types/pdfmake.d.ts"

  ],
  "exclude": [
    "node_modules"
  ]
}
