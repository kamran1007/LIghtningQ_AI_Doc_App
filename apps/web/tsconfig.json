{
  "extends": "@repo/typescript-config/nextjs.json",
  "compilerOptions": {
    "jsx": "preserve",
    "types": ["react", "react-dom"],
    "lib": ["dom", "esnext"],
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    "next.config.js",
    ".next/types/**/*.ts",
    "types/custom.d.ts",
    "src/types/pdfmake.d.ts",
    "global.d.ts"
  ],
  "exclude": ["node_modules"]
}
