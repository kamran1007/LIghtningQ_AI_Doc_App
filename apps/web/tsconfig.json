{
  "extends": "@repo/typescript-config/nextjs.json",
  "compilerOptions": {
    "jsx": "preserve", // ✅ enable JSX types
    "types": [
      "react",
      "react-dom"
    ], // ✅ load React typings
    "lib": [
      "dom",
      "esnext"
    ],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    "next.config.js",
    ".next/types/**/*.ts",
    "types/custom.d.ts",
    "src/types/pdfmake.d.ts",
    "global.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
