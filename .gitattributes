# Use LF line endings for all text files
* text=auto eol=lf

# Explicitly set line endings for source code
*.js     text eol=lf
*.ts     text eol=lf
*.tsx    text eol=lf
*.jsx    text eol=lf
*.json   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.md     text eol=lf
*.html   text eol=lf
*.css    text eol=lf
*.scss   text eol=lf
*.env*   text eol=lf
*.sh     text eol=lf

# Treat lock files as text
package-lock.json text eol=lf
yarn.lock         text eol=lf
pnpm-lock.yaml    text eol=lf

# Treat shell scripts as text and make sure they're executable
*.sh text eol=lf
*.sh text eol=lf
*.sh eol=lf
*.sh text executable

# Do not normalize binaries
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.pdf binary
*.zip binary
*.tar binary